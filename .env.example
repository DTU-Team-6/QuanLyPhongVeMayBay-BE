# Cấu hình database đã được chuẩn bị theo schema của dự án.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ve_may_bay
DB_USERNAME=veapp
DB_PASSWORD=

# Khóa JWT riêng cho từng môi trường, dài tối thiểu 32 byte.
JWT_SECRET=
COOKIE_SECURE=false
APP_FRONTEND_URL=http://localhost:5173

# Sao chép thành .env, điền thông tin riêng rồi nạp biến môi trường trước khi chạy BE.
# Không đưa mật khẩu hoặc secret thật vào file mẫu này.
# Đổi thành true khi đã điền đủ ID và secret của ít nhất một nhà cung cấp.
APP_OAUTH2_ENABLED=false

# Google OAuth client ID và client secret từ Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook App ID và App Secret từ Meta Developers.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudinary: API secret chỉ được dùng phía Backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_UPLOAD_PRESET=
